#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        WinAlt: WinAlt {
            compatible = "zmk,behavior-tap-dance";
            label = "WINALT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LALT>;

            tapping-term-ms = <220>;
        };

        layer_toggle: layer_toggle {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TOGGLE";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;

            tapping-term-ms = <220>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E    &kp R          &kp T        &kp Y    &kp U          &kp I         &kp O    &kp P     &kp LBKT
&kp LSHFT  &kp A  &kp S  &kp D    &kp F          &kp G        &kp H    &kp J          &kp K         &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C    &kp V          &kp B        &kp N    &kp M          &kp COMMA     &kp DOT  &kp FSLH  &kp RBKT
                         &WinAlt  &layer_toggle  &kp SPACE    &kp RET  &kp BACKSPACE  &kp LEFT_ALT
            >;

            label = "QWERTY";
        };

        charnav_layer {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2    &kp N3    &kp N4     &kp N5        &kp N6     &kp N7                &kp N8     &kp N9      &kp N0     &kp BACKSLASH
&trans      &kp HOME  &kp BSPC  &kp UP    &kp DEL    &caps_word    &kp PG_UP  &kp C_BRIGHTNESS_INC  &trans     &kp MINUS   &kp EQUAL  &trans
&trans      &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &to 3         &kp PG_DN  &kp C_BRIGHTNESS_DEC  &kp COMMA  &kp PERIOD  &kp SLASH  &trans
                                &trans    &trans     &kp ENTER     &kp SPACE  &trans                &trans
            >;

            label = "CHARS";
        };

        function_layer {
            bindings = <
&kp GRAVE  &kp F1        &kp F2           &kp F3      &kp F4      &kp F5          &kp F6          &kp F7          &kp F8          &kp F9           &kp F10       &kp INS
&trans     &kp F11       &kp F12          &kp C_NEXT  &kp C_PP    &kp C_VOL_UP    &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &bt BT_SEL 0  &bt BT_SEL 1
&trans     &kp CAPSLOCK  &kp PRINTSCREEN  &kp C_PREV  &kp C_MUTE  &kp C_VOL_DN    &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &bt BT_SEL 2  &bt BT_CLR
                                          &trans      &trans      &kp ENTER       &kp SPACE       &trans          &trans
            >;

            label = "FUNC";
        };

        numpad_layer {
            bindings = <
&kp BSPC        &kp SLASH  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS    &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
&kp SPACE       &kp ASTRK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS     &trans  &trans  &trans  &kp LBKT              &kp RBKT               &trans
&kp LEFT_ARROW  &kp RIGHT  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &to 0        &trans  &trans  &trans  &kp LBRC              &kp RBRC               &kp KP_NUMLOCK
                                            &kp KP_NUMBER_0  &kp KP_DOT       &kp ENTER    &trans  &trans  &trans
            >;

            label = "NUMPAD";
        };
    };
};
